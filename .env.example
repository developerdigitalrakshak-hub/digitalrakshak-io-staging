# API Base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost/digitalrakshak-project/digitalrakshak-api/public

# API Request Timeout (in milliseconds)
NEXT_PUBLIC_API_TIMEOUT=30000

# API Credentials
NEXT_PUBLIC_API_KEY=your_api_key
NEXT_PUBLIC_API_SECRET=your_api_secret

# Front API Token
NEXT_PUBLIC_API_TOKEN=your_front_api_token

# App and Client Identifiers
NEXT_PUBLIC_APP_ID=digitalrakshak_app
NEXT_PUBLIC_CLIENT_ID=digitalrakshak_client
